# Wendy 환경 변수 템플릿
# 실행에 필요한 키 이름만 적어둔 파일입니다. 실제 값은 여기에 적지 마세요.
#
# 이 프로젝트는 빌드 도구 없이 브라우저에서 바로 실행되는 정적 사이트라 .env 파일을 자동으로 읽지 않습니다.
# 아래 키를 발급받은 뒤 js/config.js 의 같은 이름 상수에 값을 넣으면 됩니다. (자세한 방법은 README.md)

# Supabase 프로젝트 (대시보드 > Project Settings > API)
# - URL: Project URL
# - ANON_KEY: anon public 키 (브라우저에 노출되어도 되는 공개 키, service_role 키는 절대 넣지 말 것)
SUPABASE_URL= "https://dmkvbvzukqtfiwyyphtl.supabase.co";
SUPABASE_ANON_KEY= "sb_publishable_nFz7j6nrEGchxMVp-CBh1Q_XuQsKpw4";

# NEIS 교육정보 개방 포털 인증키 (https://open.neis.go.kr > 인증키 신청)
# 학교 검색(schoolInfo)과 학사일정(SchoolSchedule) 조회에 사용
NEIS_API_KEY= "86095495716846249395b771112a109d";

# (선택) 공공데이터포털 "한국천문연구원_특일 정보" 인증키 (https://www.data.go.kr)
# 공휴일 표시에 사용. 비워두면 js/holidays.js 의 공휴일 규칙으로 직접 계산해서 표시합니다.
HOLIDAY_API_KEY= "d168977e00187899eab3fe76b6d6f9223ea9b6ecc683de17dd10c298bdef9901";
